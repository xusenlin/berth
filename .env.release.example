# Copy to .env.release (ignored by git) for `task release`.

# A "Developer ID Application" certificate in the login keychain; Apple
# Development and Apple Distribution certificates do not pass Gatekeeper.
# List them with: security find-identity -v -p codesigning
MACOS_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Optional: a Windows code signing certificate. Unsigned installers work, but
# SmartScreen warns about them.
WINDOWS_PFX=
WINDOWS_PFX_PASSWORD=
